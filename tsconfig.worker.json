{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-pool-workers"]
  },
  "include": [
    "src/worker.ts",
    "src/management-http.ts",
    "src/dashboard-http.ts",
    "src/public-ingress.ts",
    "src/durable-object.ts",
    "src/router-index.ts",
    "src/connection-log.ts",
    "src/connection-log-storage.ts",
    "src/dashboard.ts",
    "src/dashboard-session.ts",
    "src/management-auth.ts",
    "src/forward.ts",
    "src/credentials.ts",
    "src/hmac-sha256.ts",
    "src/random-hex.ts",
    "src/timing-safe-equal.ts",
    "src/oauth-state.ts",
    "src/tunnel-protocol.ts",
    "src/dev-router-types.ts",
    "src/route-id.ts",
    "src/router-headers.ts",
    "src/subscriber-lifetime.ts",
    "src/target-base-url.ts",
    "src/ingress-urls.ts",
    "worker-configuration.d.ts",
    "test/worker/**/*.ts",
    "test/worker/env.d.ts"
  ]
}

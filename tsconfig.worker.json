{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-pool-workers"]
  },
  "include": [
    "src/worker.ts",
    "src/durable-object.ts",
    "src/forward.ts",
    "src/auth.ts",
    "src/types.ts",
    "src/shared.ts",
    "worker-configuration.d.ts",
    "test/worker/**/*.ts",
    "test/worker/env.d.ts"
  ]
}

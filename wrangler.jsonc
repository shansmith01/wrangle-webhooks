{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dev-router",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROUTE",
        "class_name": "RouteDurableObject"
      },
      {
        "name": "ROUTER_INDEX",
        "class_name": "RouterIndex"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RouteDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RouterIndex"]
    }
  ]
}

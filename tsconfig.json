{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "src/client.ts",
    "src/cli.ts",
    "src/cli-command.ts",
    "src/dev-router-types.ts",
    "src/connection-log.ts",
    "src/connection-retry.ts",
    "src/connection-state.ts",
    "src/credentials.ts",
    "src/control-server.ts",
    "src/detect-url.ts",
    "src/hmac-sha256.ts",
    "src/ingress-urls.ts",
    "src/local-url.ts",
    "src/management-fetch.ts",
    "src/oauth-state.ts",
    "src/random-hex.ts",
    "src/route-id.ts",
    "src/router-headers.ts",
    "src/subscriber-lifetime.ts",
    "src/target-base-url.ts",
    "src/timing-safe-equal.ts",
    "src/tunnel-protocol.ts",
    "src/tunnel-client.ts",
    "src/wait-for-shutdown.ts",
    "test/unit/**/*.ts"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["src/client.ts", "src/cli.ts", "src/types.ts", "src/shared.ts", "src/detect-url.ts", "test/unit/**/*.ts"]
}

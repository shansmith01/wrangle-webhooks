{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "src/client.ts",
    "src/cli.ts",
    "src/cli-command.ts",
    "src/types.ts",
    "src/shared.ts",
    "src/connection-state.ts",
    "src/detect-url.ts",
    "src/oauth-state.ts",
    "src/tunnel-protocol.ts",
    "src/tunnel-client.ts",
    "src/management-fetch.ts",
    "src/wait-for-shutdown.ts",
    "test/unit/**/*.ts"
  ]
}
